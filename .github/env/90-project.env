# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for gtask-extractor
# Load Order: 90 (loaded after all defaults, overrides tool-specific settings)
#
# This file contains project-specific configuration that overrides defaults from
# earlier env files (00-core, 10-*, 20-*). Only values that differ from defaults
# need to be specified here.
#
# Maintainer: @mrz1836
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Project Go versions (overrides 00-core.env defaults)
GO_PRIMARY_VERSION=1.26.x
GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 🪄 MAGE-X GO VERSION OVERRIDES
# ================================================================================================

MAGE_X_GO_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 📊 COVERAGE PROVIDER
# ================================================================================================

# Use Codecov for coverage reporting (overrides 10-coverage.env default of 'internal')
GO_COVERAGE_PROVIDER=codecov
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusions matching codecov.yml ignore paths
GO_COVERAGE_EXCLUDE_PATHS=test/,vendor/,testdata/,.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/

# ================================================================================================
# 🏗️ BUILD TAG CONFIGURATION
# ================================================================================================

# Exclude windows build tag from auto-discovery (macOS incompatible)
# Prevents MAGE-X from testing with windows build tag on macOS systems
# which causes Go compiler conflicts with zgoos_* files
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,windows

# ================================================================================================
# 🛡️ SECURITY EXCLUSIONS
# ================================================================================================

# Nancy CVE Exclusions
NANCY_EXCLUDES=CVE-2023-42319,CVE-2026-26958

# Custom exclusions for Govulncheck/Magex vulnerability scanning
#
# GO-2026-6443 (CVE-2026-84445 / GHSA-2v4p-qf9q-27wj): grpc server panic when an xDS-routed
# gRPC server receives requests without :authority/Host headers. Not reachable here:
# gtask-extractor is a REST client of the Google Tasks API and never runs a gRPC server
# (grpc is only imported via google.golang.org/api/option), and govulncheck's symbol scan
# reports 0 affected vulnerabilities. `magex deps:audit` still fails on package-level
# findings, hence the exclusion. grpc v1.84.0 is affected and the only fixed version is an
# unreleased dev pseudo-version (v1.85.0-dev.0.20260825072537-93e31b48545e).
# Remove once go.mod resolves a fixed grpc release (v1.85.0+ or a v1.84.x patch).
MAGE_X_CVE_EXCLUDES=GO-2026-5932,GO-2026-6443

# ================================================================================================
# 🧪 TEST CONFIGURATION
# ================================================================================================

# Increase fuzz test timeout to prevent context deadline exceeded errors in CI
TEST_TIMEOUT_FUZZ=10m

# Ensure magex gives enough buffer for the fuzz tests to complete
MAGE_X_FUZZ_MIN_TIMEOUT=1m
